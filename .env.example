# --- bmit-backend environment (SAFE PLACEHOLDERS ONLY) ---

# MongoDB Atlas connection string (SERVER ONLY — never sent to any frontend)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/bmit_certificates?retryWrites=true&w=majority

# 256-bit secret used to sign staff JWTs (generate: openssl rand -hex 32)
JWT_SECRET=replace_with_64_char_hex_secret

# Allowed browser origins (comma separated). Unknown origins are rejected with 403.
CORS_ORIGINS=https://YOUR-USER-FRONTEND.vercel.app,https://YOUR-STAFF-FRONTEND.vercel.app

# Public URL of the USER frontend (used to build verification/QR URLs)
USER_APP_URL=https://YOUR-USER-FRONTEND.vercel.app

# Staff login username
STAFF_USERNAME=registrar@bluemantletechnology.com

# Staff login password hash (node:crypto scrypt). Generate: npm run hash-password -- "your-password"
STAFF_PASSWORD_HASH=scrypt$<salt_hex>$<hash_hex>

# HTTP port (Render injects this automatically)
PORT=5000

# Optional: set to 1 when behind a reverse proxy that sets X-Forwarded-For (Render: 1)
TRUST_PROXY=0
